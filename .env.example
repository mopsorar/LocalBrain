# Local Ollama only: localhost, loopback or a private IP address.
# Compose overrides this with http://ollama:11434 and sets its own Linux data paths.
OLLAMA_BASE_URL=http://localhost:11434
# Names only; Bootstrap never downloads models.
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_CONNECT_TIMEOUT=5
OLLAMA_READ_TIMEOUT=120

# Relative paths are resolved from the project root, regardless of the working directory.
# If you change these paths, exclude the new data directories in .gitignore too.
DOCUMENTS_DIR=knowledge_base
# Keep private documents in documents/ or knowledge_base/private/ (both ignored).
CHROMA_PERSIST_DIR=data/chroma
UPLOADS_DIR=documents/uploads

# CLI connects only to a local HTTP API. Run Uvicorn with one worker.
API_BASE_URL=http://127.0.0.1:8000
API_CONNECT_TIMEOUT=5
API_READ_TIMEOUT=300

# Container models live in a separate volume. Pull them explicitly after starting Ollama:
# docker compose exec ollama ollama pull qwen2.5:1.5b
# docker compose exec ollama ollama pull nomic-embed-text
